# Optional local debug URL for Playwright baseURL.
# Scenario env routing still follows E2E_VERSION -> env.homeUrl.
BASE_URL=https://newqa-3chat.frp.newcoretech.com/

# Profile runner
E2E_RUN_MODE=manual
E2E_VERSION=cn
E2E_SCENARIOS=
E2E_LOCALIZATION=true
E2E_SCENARIO_TIMEOUT_MS=480000
E2E_SCENARIO_RETRIES=1
E2E_REGISTER_PHONE_SMS_COOLDOWN_MS=65000
E2E_TENANT_DISABLE_URL_CN=
E2E_TENANT_DISABLE_URL_INTL=
E2E_TENANT_CLEANUP_FEISHU_NOTIFY=true
E2E_LOCALIZATION_TIMEOUT_MS=900000

FEISHU_WEBHOOK_URL=
E2E_LOCALIZATION_FEISHU_WEBHOOK_URL=
E2E_FEISHU_NOTIFY=failed

# Optional report email. Only profile-run/e2e-launcher sends one email after the full suite finishes.
E2E_REPORT_EMAIL_NOTIFY=always
E2E_REPORT_EMAIL_TO=
E2E_EMAIL_API_URL=
E2E_REPORT_EMAIL_FAILURE_FEISHU_WEBHOOK_URL=

# Registration verification code log service
# Phone and email registration codes are queried from Aliyun logs.
# Project/logstore are selected by E2E_VERSION from configs/env.cn.ts and configs/env.intl.ts.
ALIYUN_LOG_TOKEN=your_token

# Optional email domain override. Defaults to e2eTestEmail.com.
E2E_TEST_EMAIL_DOMAIN=e2eTestEmail.com

# Mainland SMS Log
ALIYUN_SMS_LOG_PROJECT=xinheyun-prod
ALIYUN_SMS_LOGSTORE=prod

# International SMS Log
ALIYUN_SMS_LOG_PROJECT_INTL=k8s-log-c02e5f3e3e48a44ff9c7236b696573353
ALIYUN_SMS_LOGSTORE_INTL=prod-sg

# Registration and workspace data
E2E_REGISTER_TYPE=email
E2E_LOGIN_METHOD=password
E2E_LOGIN_EMAIL_CODE_ACCOUNT=TestIgnored@qq.com
E2E_TEST_PASSWORD=TestPassword123!
E2E_WORKSPACE_NAME=E2ETest
E2E_CONTACT_PHONE=15000000001

# CN login
ADD_SPACE_CN_HOME_URL=https://www.3chatai.cn/
ADD_SPACE_CN_LOGIN_EMAIL=TestIgnored@qq.com
ADD_SPACE_CN_LOGIN_PASSWORD=1qaz!QAZ

# International login. Leave email/password empty to reuse ADD_SPACE_CN_LOGIN_EMAIL/PASSWORD.
ADD_SPACE_INTL_HOME_URL=https://www.3chat.ai/
ADD_SPACE_INTL_LOGIN_EMAIL=
ADD_SPACE_INTL_LOGIN_PASSWORD=

# Legacy channel fallback. Prefer ADD_SPACE_CN_* for new configuration.
CHANNEL_LINK_HOME_URL=
CHANNEL_LINK_LOGIN_EMAIL=
CHANNEL_LINK_LOGIN_PASSWORD=

# Optional: use local Chrome instead of Playwright bundled Chromium.
# PLAYWRIGHT_CHANNEL=chrome
